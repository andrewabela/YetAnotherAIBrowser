{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yetanotheraibrowser",
  "version": "0.1.0",
  "identifier": "page.newlevel.yetanotheraibrowser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yet Another AI Browser (Alpha)",
        "width": 800,
        "height": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "pre_def_config.json"
    ],
    "targets": ["nsis", "rpm", "deb", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    }
  }
}
